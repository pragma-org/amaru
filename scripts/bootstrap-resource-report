"""Collect and render cgroup resource usage for bootstrap runs."""

from __future__ import annotations

import argparse
import csv
import html
import json
import math
import os
import signal
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterable


READY_TIMEOUT_SECONDS = 60.0
ACK_TIMEOUT_SECONDS = 15.0
CGROUP_TIMEOUT_SECONDS = 30.0
MARKER_POLL_SECONDS = 0.05
MIB = 1024 * 1024

SAMPLE_COLUMNS = [
    "timestamp_ms",
    "elapsed_seconds",
    "memory_current_bytes",
    "memory_peak_bytes",
    "memory_swap_current_bytes",
    "cpu_usage_usec",
    "cpu_user_usec",
    "cpu_system_usec",
    "cpu_nr_periods",
    "cpu_nr_throttled",
    "cpu_throttled_usec",
    "cpu_nr_bursts",
    "cpu_burst_usec",
    "cpu_percent_one_core",
    "memory_events_low",
    "memory_events_high",
    "memory_events_max",
    "memory_events_oom",
    "memory_events_oom_kill",
    "memory_events_oom_group_kill",
]


@dataclass(frozen=True)
class ResourceSample:
    timestamp_ms: int
    elapsed_seconds: float
    memory_current_bytes: int | None
    memory_peak_bytes: int | None
    memory_swap_current_bytes: int | None
    cpu_percent_one_core: float | None
    memory_events_oom: int | None
    memory_events_oom_kill: int | None
    memory_events_oom_group_kill: int | None


@dataclass(frozen=True)
class EpochMarker:
    timestamp_ms: int
    epoch: str


def atomic_write_text(path: Path, contents: str) -> None:
    """Replace a marker only after its complete contents are on disk."""

    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary_path = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(contents)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary_path, path)
    finally:
        try:
            temporary_path.unlink()
        except FileNotFoundError:
            pass


def unlink_if_present(path: Path) -> None:
    try:
        path.unlink()
    except FileNotFoundError:
        pass


def process_exists(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def wait_for_file(path: Path, timeout_seconds: float) -> bool:
    deadline = time.monotonic() + timeout_seconds
    while time.monotonic() < deadline:
        if path.exists():
            return True
        time.sleep(MARKER_POLL_SECONDS)
    return path.exists()


def normalize_return_code(return_code: int) -> int:
    if return_code < 0:
        return 128 + abs(return_code)
    return return_code


def increase_child_oom_score(pid: int, proc_root: Path = Path("/proc"), score: int = 1000) -> bool:
    """Make the workload preferable to its coordinator when Linux selects an OOM victim."""

    try:
        (proc_root / str(pid) / "oom_score_adj").write_text(f"{score}\n", encoding="ascii")
    except (OSError, ValueError):
        return False
    return True


def run_command(args: argparse.Namespace) -> int:
    command = list(args.command)
    if command and command[0] == "--":
        command.pop(0)
    if not command:
        raise ValueError("run requires a command after --")

    unlink_if_present(args.finished_file)
    unlink_if_present(args.ack_file)

    if not wait_for_file(args.ready_file, READY_TIMEOUT_SECONDS):
        raise RuntimeError(f"timed out waiting for sampler readiness marker: {args.ready_file}")

    try:
        child = subprocess.Popen(command)
        increase_child_oom_score(child.pid)
        return_code = child.wait()
    except OSError as error:
        print(f"failed to launch {command[0]}: {error}", file=sys.stderr)
        return_code = 127

    normalized_return_code = normalize_return_code(return_code)
    atomic_write_text(args.finished_file, f"{normalized_return_code}\n")
    if not wait_for_file(args.ack_file, ACK_TIMEOUT_SECONDS):
        print(f"warning: timed out waiting for sampler acknowledgement: {args.ack_file}", file=sys.stderr)

    return normalized_return_code


def read_integer(path: Path) -> int | None:
    try:
        value = path.read_text(encoding="utf-8").strip()
        return int(value)
    except (FileNotFoundError, OSError, ValueError):
        return None


def read_key_values(path: Path) -> dict[str, int]:
    values: dict[str, int] = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (FileNotFoundError, OSError):
        return values

    for line in lines:
        fields = line.split()
        if len(fields) != 2:
            continue
        try:
            values[fields[0]] = int(fields[1])
        except ValueError:
            continue
    return values


def wait_for_cgroup(cgroup: Path, watch_pid: int) -> None:
    required_paths = [cgroup / "memory.current", cgroup / "cpu.stat"]
    deadline = time.monotonic() + CGROUP_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        if all(path.is_file() for path in required_paths):
            return
        if not process_exists(watch_pid):
            raise RuntimeError(f"watched process {watch_pid} exited before cgroup became available: {cgroup}")
        time.sleep(MARKER_POLL_SECONDS)
    raise RuntimeError(f"timed out waiting for cgroup files under {cgroup}")


def capture_sample(
    cgroup: Path,
    started_at: float,
    previous_cpu_usage: int | None,
    previous_sampled_at: float | None,
) -> tuple[dict[str, int | float | None], int | None, float]:
    sampled_at = time.monotonic()
    cpu = read_key_values(cgroup / "cpu.stat")
    memory_events = read_key_values(cgroup / "memory.events")
    cpu_usage = cpu.get("usage_usec")

    if previous_cpu_usage is None or previous_sampled_at is None:
        cpu_percent: float | None = 0.0
    elif cpu_usage is None:
        cpu_percent = None
    else:
        wall_usec = max((sampled_at - previous_sampled_at) * 1_000_000.0, 1.0)
        cpu_percent = max(0.0, (cpu_usage - previous_cpu_usage) * 100.0 / wall_usec)

    row: dict[str, int | float | None] = {
        "timestamp_ms": time.time_ns() // 1_000_000,
        "elapsed_seconds": round(sampled_at - started_at, 6),
        "memory_current_bytes": read_integer(cgroup / "memory.current"),
        "memory_peak_bytes": read_integer(cgroup / "memory.peak"),
        "memory_swap_current_bytes": read_integer(cgroup / "memory.swap.current"),
        "cpu_usage_usec": cpu_usage,
        "cpu_user_usec": cpu.get("user_usec"),
        "cpu_system_usec": cpu.get("system_usec"),
        "cpu_nr_periods": cpu.get("nr_periods"),
        "cpu_nr_throttled": cpu.get("nr_throttled"),
        "cpu_throttled_usec": cpu.get("throttled_usec"),
        "cpu_nr_bursts": cpu.get("nr_bursts"),
        "cpu_burst_usec": cpu.get("burst_usec"),
        "cpu_percent_one_core": round(cpu_percent, 3) if cpu_percent is not None else None,
        "memory_events_low": memory_events.get("low"),
        "memory_events_high": memory_events.get("high"),
        "memory_events_max": memory_events.get("max"),
        "memory_events_oom": memory_events.get("oom"),
        "memory_events_oom_kill": memory_events.get("oom_kill"),
        "memory_events_oom_group_kill": memory_events.get("oom_group_kill"),
    }
    return row, cpu_usage, sampled_at


def sample_cgroup(args: argparse.Namespace) -> int:
    if args.interval <= 0:
        raise ValueError("--interval must be greater than zero")
    if args.watch_pid <= 0:
        raise ValueError("--watch-pid must be a positive process ID")

    unlink_if_present(args.ready_file)
    unlink_if_present(args.ack_file)
    wait_for_cgroup(args.cgroup, args.watch_pid)

    args.output.parent.mkdir(parents=True, exist_ok=True)
    started_at = time.monotonic()
    previous_cpu_usage: int | None = None
    previous_sampled_at: float | None = None
    ready_written = False
    watched_process_exited = False

    try:
        with args.output.open("w", newline="", encoding="utf-8") as handle:
            writer = csv.DictWriter(handle, fieldnames=SAMPLE_COLUMNS)
            writer.writeheader()

            row, previous_cpu_usage, previous_sampled_at = capture_sample(
                args.cgroup, started_at, previous_cpu_usage, previous_sampled_at
            )
            writer.writerow(row)
            handle.flush()
            atomic_write_text(args.ready_file, "ready\n")
            ready_written = True

            while not args.finished_file.exists():
                if not process_exists(args.watch_pid):
                    watched_process_exited = True
                    break

                sample_deadline = time.monotonic() + args.interval
                while time.monotonic() < sample_deadline:
                    if args.finished_file.exists() or not process_exists(args.watch_pid):
                        break
                    time.sleep(min(MARKER_POLL_SECONDS, max(0.0, sample_deadline - time.monotonic())))

                if args.finished_file.exists():
                    break
                if not process_exists(args.watch_pid):
                    watched_process_exited = True
                    break

                row, previous_cpu_usage, previous_sampled_at = capture_sample(
                    args.cgroup, started_at, previous_cpu_usage, previous_sampled_at
                )
                writer.writerow(row)
                handle.flush()

            final_row, _, _ = capture_sample(args.cgroup, started_at, previous_cpu_usage, previous_sampled_at)
            writer.writerow(final_row)
            handle.flush()
    finally:
        if ready_written:
            atomic_write_text(args.ack_file, "acknowledged\n")

    if watched_process_exited and not args.finished_file.exists():
        print(f"watched process {args.watch_pid} exited before completion marker was written", file=sys.stderr)
        return 1
    return 0


def parse_optional_int(value: Any) -> int | None:
    if value is None:
        return None
    text = str(value).strip()
    if not text:
        return None
    try:
        return int(text)
    except ValueError:
        return None


def parse_optional_float(value: Any) -> float | None:
    if value is None:
        return None
    text = str(value).strip()
    if not text:
        return None
    try:
        parsed = float(text)
    except ValueError:
        return None
    return parsed if math.isfinite(parsed) else None


def load_samples(path: Path) -> list[ResourceSample]:
    if not path.is_file():
        return []

    samples: list[ResourceSample] = []
    try:
        with path.open(newline="", encoding="utf-8", errors="replace") as handle:
            for row in csv.DictReader(handle):
                timestamp_ms = parse_optional_int(row.get("timestamp_ms"))
                if timestamp_ms is None:
                    continue
                elapsed_seconds = parse_optional_float(row.get("elapsed_seconds"))
                samples.append(
                    ResourceSample(
                        timestamp_ms=timestamp_ms,
                        elapsed_seconds=elapsed_seconds if elapsed_seconds is not None else math.nan,
                        memory_current_bytes=parse_optional_int(row.get("memory_current_bytes")),
                        memory_peak_bytes=parse_optional_int(row.get("memory_peak_bytes")),
                        memory_swap_current_bytes=parse_optional_int(row.get("memory_swap_current_bytes")),
                        cpu_percent_one_core=parse_optional_float(row.get("cpu_percent_one_core")),
                        memory_events_oom=parse_optional_int(row.get("memory_events_oom")),
                        memory_events_oom_kill=parse_optional_int(row.get("memory_events_oom_kill")),
                        memory_events_oom_group_kill=parse_optional_int(row.get("memory_events_oom_group_kill")),
                    )
                )
    except OSError:
        return []
    except csv.Error:
        # Keep rows parsed before a truncated final record.
        pass

    samples.sort(key=lambda sample: sample.timestamp_ms)
    if not samples:
        return samples

    first_timestamp = samples[0].timestamp_ms
    first_elapsed = samples[0].elapsed_seconds if math.isfinite(samples[0].elapsed_seconds) else 0.0
    return [
        ResourceSample(
            timestamp_ms=sample.timestamp_ms,
            elapsed_seconds=(
                sample.elapsed_seconds
                if math.isfinite(sample.elapsed_seconds)
                else first_elapsed + (sample.timestamp_ms - first_timestamp) / 1000.0
            ),
            memory_current_bytes=sample.memory_current_bytes,
            memory_peak_bytes=sample.memory_peak_bytes,
            memory_swap_current_bytes=sample.memory_swap_current_bytes,
            cpu_percent_one_core=sample.cpu_percent_one_core,
            memory_events_oom=sample.memory_events_oom,
            memory_events_oom_kill=sample.memory_events_oom_kill,
            memory_events_oom_group_kill=sample.memory_events_oom_group_kill,
        )
        for sample in samples
    ]


def parse_timestamp_ms(value: Any) -> int | None:
    if isinstance(value, (int, float)) and math.isfinite(value):
        return int(value if value >= 1_000_000_000_000 else value * 1000)
    if not isinstance(value, str) or not value.strip():
        return None

    text = value.strip()
    try:
        instant = datetime.fromisoformat(text.replace("Z", "+00:00"))
    except ValueError:
        return None
    if instant.tzinfo is None:
        instant = instant.replace(tzinfo=timezone.utc)
    return int(instant.timestamp() * 1000)


def extract_json_record(line: str) -> dict[str, Any] | None:
    stripped = line.strip()
    if not stripped:
        return None
    try:
        parsed = json.loads(stripped)
        return parsed if isinstance(parsed, dict) else None
    except json.JSONDecodeError:
        pass

    decoder = json.JSONDecoder()
    for index, character in enumerate(line):
        if character != "{":
            continue
        try:
            parsed, _ = decoder.raw_decode(line[index:])
        except json.JSONDecodeError:
            continue
        if isinstance(parsed, dict):
            return parsed
    return None


def is_true(value: Any) -> bool:
    return value is True or (isinstance(value, str) and value.lower() == "true")


def load_epoch_markers(path: Path) -> list[EpochMarker]:
    if not path.is_file():
        return []

    candidates: list[EpochMarker] = []
    try:
        with path.open(encoding="utf-8", errors="replace") as handle:
            for line in handle:
                record = extract_json_record(line)
                if record is None or record.get("target") != "amaru::stores":
                    continue
                fields = record.get("fields") if isinstance(record.get("fields"), dict) else {}
                if fields.get("message") != "enter":
                    continue

                database_tag = record.get("amaru.tag.db", fields.get("amaru.tag.db"))
                epoch = record.get("epoch", fields.get("epoch"))
                timestamp_ms = parse_timestamp_ms(record.get("timestamp"))
                if not is_true(database_tag) or epoch is None or timestamp_ms is None:
                    continue
                candidates.append(EpochMarker(timestamp_ms=timestamp_ms, epoch=str(epoch)))
    except OSError:
        return []

    candidates.sort(key=lambda marker: marker.timestamp_ms)
    markers: list[EpochMarker] = []
    seen_epochs: set[str] = set()
    for marker in candidates:
        if marker.epoch in seen_epochs:
            continue
        seen_epochs.add(marker.epoch)
        markers.append(marker)
    return markers


def maximum(values: Iterable[int | float | None]) -> int | float | None:
    present = [value for value in values if value is not None]
    return max(present) if present else None


def format_bytes(value: int | float | None) -> str:
    if value is None:
        return "n/a"
    return f"{float(value) / MIB:.1f} MiB"


def format_percent(value: int | float | None) -> str:
    if value is None:
        return "n/a"
    return f"{float(value):.1f}%"


def build_summary(samples: list[ResourceSample], markers: list[EpochMarker], memory_limit_bytes: int) -> dict[str, Any]:
    elapsed = [sample.elapsed_seconds for sample in samples]
    return {
        "sample_count": len(samples),
        "duration_seconds": round(max(elapsed) - min(elapsed), 3) if elapsed else None,
        "epoch_marker_count": len(markers),
        "memory_limit_bytes": memory_limit_bytes,
        "max_memory_current_bytes": maximum(sample.memory_current_bytes for sample in samples),
        "max_memory_peak_bytes": maximum(sample.memory_peak_bytes for sample in samples),
        "max_memory_swap_current_bytes": maximum(sample.memory_swap_current_bytes for sample in samples),
        "max_cpu_percent_one_core": maximum(sample.cpu_percent_one_core for sample in samples),
        "oom_events": maximum(sample.memory_events_oom for sample in samples) or 0,
        "oom_kill_events": maximum(sample.memory_events_oom_kill for sample in samples) or 0,
        "oom_group_kill_events": maximum(sample.memory_events_oom_group_kill for sample in samples) or 0,
    }


def build_markdown_summary(summary: dict[str, Any]) -> str:
    duration = summary["duration_seconds"]
    duration_label = f"{duration} s" if duration is not None else "n/a"
    lines = [
        "## Bootstrap resource usage",
        "",
        "| Metric | Value |",
        "|---|---:|",
        f"| Samples | {summary['sample_count']} |",
        f"| Duration | {duration_label} |",
        f"| Epoch markers | {summary['epoch_marker_count']} |",
        f"| Memory limit | {format_bytes(summary['memory_limit_bytes'])} |",
        f"| Maximum current memory | {format_bytes(summary['max_memory_current_bytes'])} |",
        f"| Maximum reported memory peak | {format_bytes(summary['max_memory_peak_bytes'])} |",
        f"| Maximum swap | {format_bytes(summary['max_memory_swap_current_bytes'])} |",
        f"| Maximum CPU (100% = one core) | {format_percent(summary['max_cpu_percent_one_core'])} |",
        f"| OOM events | {summary['oom_events']} |",
        f"| OOM kills | {summary['oom_kill_events']} |",
        f"| OOM group kills | {summary['oom_group_kill_events']} |",
        "",
    ]
    return "\n".join(lines)


def write_markers(path: Path, markers: list[EpochMarker], samples: list[ResourceSample]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    first_timestamp = samples[0].timestamp_ms if samples else None
    first_elapsed = samples[0].elapsed_seconds if samples else 0.0
    with path.open("w", newline="", encoding="utf-8") as handle:
        writer = csv.DictWriter(handle, fieldnames=["timestamp_ms", "elapsed_seconds", "epoch"])
        writer.writeheader()
        for marker in markers:
            elapsed = (
                round(first_elapsed + (marker.timestamp_ms - first_timestamp) / 1000.0, 6)
                if first_timestamp is not None
                else None
            )
            writer.writerow({"timestamp_ms": marker.timestamp_ms, "elapsed_seconds": elapsed, "epoch": marker.epoch})


def svg_polyline(
    samples: list[ResourceSample],
    value_getter: Any,
    x_coordinate: Any,
    y_coordinate: Any,
    color: str,
    series_name: str,
    dasharray: str | None = None,
) -> list[str]:
    points = [
        (x_coordinate(sample.elapsed_seconds), y_coordinate(value))
        for sample in samples
        if (value := value_getter(sample)) is not None
    ]
    if not points:
        return []
    encoded_points = " ".join(f"{x:.2f},{y:.2f}" for x, y in points)
    dash = f' stroke-dasharray="{dasharray}"' if dasharray is not None else ""
    elements = [
        f'<polyline data-series="{series_name}" points="{encoded_points}" fill="none" stroke="{color}" '
        f'stroke-width="3" stroke-linejoin="round" stroke-linecap="round"{dash}/>'
    ]
    if len(points) == 1:
        x, y = points[0]
        elements.append(f'<circle cx="{x:.2f}" cy="{y:.2f}" r="4" fill="{color}"/>')
    return elements


def build_svg(samples: list[ResourceSample], markers: list[EpochMarker], memory_limit_bytes: int) -> str:
    width = 1600
    height = 900
    left = 110
    right = 45
    top = 85
    panel_height = 300
    panel_gap = 95
    memory_bottom = top + panel_height
    cpu_top = memory_bottom + panel_gap
    cpu_bottom = cpu_top + panel_height
    plot_width = width - left - right

    elapsed_values = [sample.elapsed_seconds for sample in samples]
    minimum_elapsed = min(elapsed_values) if elapsed_values else 0.0
    maximum_elapsed = max(elapsed_values) if elapsed_values else 1.0
    if maximum_elapsed <= minimum_elapsed:
        maximum_elapsed = minimum_elapsed + 1.0

    memory_values = [
        value
        for sample in samples
        for value in (sample.memory_current_bytes, sample.memory_peak_bytes)
        if value is not None
    ]
    memory_maximum = max([memory_limit_bytes, *memory_values, 1]) * 1.08
    cpu_values = [sample.cpu_percent_one_core for sample in samples if sample.cpu_percent_one_core is not None]
    cpu_maximum = max([100.0, *cpu_values, 1.0]) * 1.08

    def x_coordinate(elapsed: float) -> float:
        return left + (elapsed - minimum_elapsed) * plot_width / (maximum_elapsed - minimum_elapsed)

    def memory_y(value: int | float) -> float:
        return memory_bottom - float(value) * panel_height / memory_maximum

    def cpu_y(value: int | float) -> float:
        return cpu_bottom - float(value) * panel_height / cpu_maximum

    elements = [
        '<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="900" viewBox="0 0 1600 900" '
        'role="img" aria-labelledby="title description">',
        '<title id="title">Amaru bootstrap resource usage</title>',
        '<desc id="description">Cgroup memory and CPU usage over time with completed epoch import markers.</desc>',
        '<rect width="1600" height="900" fill="#ffffff"/>',
        '<style>text { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; fill: #172033; } '
        '.axis { stroke: #4b5563; stroke-width: 1.5; } .grid { stroke: #d9dee8; stroke-width: 1; } '
        '.label { font-size: 18px; } .tick { font-size: 14px; } .marker-label { font-size: 12px; fill: #6d28d9; }</style>',
        '<text x="800" y="38" text-anchor="middle" font-size="25" font-weight="bold">Amaru bootstrap resource usage</text>',
        f'<rect x="{left}" y="{top}" width="{plot_width}" height="{panel_height}" fill="#f8fafc"/>',
        f'<rect x="{left}" y="{cpu_top}" width="{plot_width}" height="{panel_height}" fill="#f8fafc"/>',
    ]

    for tick in range(6):
        ratio = tick / 5
        memory_value = memory_maximum * ratio
        memory_tick_y = memory_bottom - panel_height * ratio
        cpu_value = cpu_maximum * ratio
        cpu_tick_y = cpu_bottom - panel_height * ratio
        elapsed_value = minimum_elapsed + (maximum_elapsed - minimum_elapsed) * ratio
        tick_x = left + plot_width * ratio
        elements.extend(
            [
                f'<line class="grid" x1="{left}" y1="{memory_tick_y:.2f}" x2="{width - right}" y2="{memory_tick_y:.2f}"/>',
                f'<text class="tick" x="{left - 12}" y="{memory_tick_y + 5:.2f}" text-anchor="end">{memory_value / MIB:.0f}</text>',
                f'<line class="grid" x1="{left}" y1="{cpu_tick_y:.2f}" x2="{width - right}" y2="{cpu_tick_y:.2f}"/>',
                f'<text class="tick" x="{left - 12}" y="{cpu_tick_y + 5:.2f}" text-anchor="end">{cpu_value:.0f}</text>',
                f'<line class="grid" x1="{tick_x:.2f}" y1="{top}" x2="{tick_x:.2f}" y2="{memory_bottom}"/>',
                f'<line class="grid" x1="{tick_x:.2f}" y1="{cpu_top}" x2="{tick_x:.2f}" y2="{cpu_bottom}"/>',
                f'<text class="tick" x="{tick_x:.2f}" y="{cpu_bottom + 27}" text-anchor="middle">{elapsed_value:.1f}</text>',
            ]
        )

    elements.extend(
        [
            f'<line class="axis" x1="{left}" y1="{top}" x2="{left}" y2="{memory_bottom}"/>',
            f'<line class="axis" x1="{left}" y1="{memory_bottom}" x2="{width - right}" y2="{memory_bottom}"/>',
            f'<line class="axis" x1="{left}" y1="{cpu_top}" x2="{left}" y2="{cpu_bottom}"/>',
            f'<line class="axis" x1="{left}" y1="{cpu_bottom}" x2="{width - right}" y2="{cpu_bottom}"/>',
            f'<text class="label" x="30" y="{top + panel_height / 2}" text-anchor="middle" '
            f'transform="rotate(-90 30 {top + panel_height / 2})">Memory (MiB)</text>',
            f'<text class="label" x="30" y="{cpu_top + panel_height / 2}" text-anchor="middle" '
            f'transform="rotate(-90 30 {cpu_top + panel_height / 2})">CPU (100% = one core)</text>',
            f'<text class="label" x="{left + plot_width / 2}" y="{cpu_bottom + 58}" text-anchor="middle">Elapsed time (seconds)</text>',
        ]
    )

    if memory_limit_bytes >= 0:
        limit_y = memory_y(memory_limit_bytes)
        elements.extend(
            [
                f'<line data-series="memory-limit" x1="{left}" y1="{limit_y:.2f}" x2="{width - right}" '
                f'y2="{limit_y:.2f}" stroke="#dc2626" stroke-width="2" stroke-dasharray="10 7"/>',
                f'<text x="{width - right - 8}" y="{limit_y - 8:.2f}" text-anchor="end" font-size="14" fill="#dc2626">'
                f'Limit {memory_limit_bytes / MIB:.1f} MiB</text>',
            ]
        )

    if samples:
        elements.extend(
            svg_polyline(
                samples,
                lambda sample: sample.memory_peak_bytes,
                x_coordinate,
                memory_y,
                "#d97706",
                "memory-peak",
                "8 6",
            )
        )
        elements.extend(
            svg_polyline(
                samples,
                lambda sample: sample.memory_current_bytes,
                x_coordinate,
                memory_y,
                "#2563eb",
                "memory-current",
            )
        )
        elements.extend(
            svg_polyline(
                samples,
                lambda sample: sample.cpu_percent_one_core,
                x_coordinate,
                cpu_y,
                "#059669",
                "cpu-percent",
            )
        )
    else:
        elements.extend(
            [
                f'<text x="{left + plot_width / 2}" y="{top + panel_height / 2}" text-anchor="middle" font-size="18">No memory samples captured</text>',
                f'<text x="{left + plot_width / 2}" y="{cpu_top + panel_height / 2}" text-anchor="middle" font-size="18">No CPU samples captured</text>',
            ]
        )

    if samples:
        first_timestamp = samples[0].timestamp_ms
        first_elapsed = samples[0].elapsed_seconds
        for index, marker in enumerate(markers):
            marker_elapsed = first_elapsed + (marker.timestamp_ms - first_timestamp) / 1000.0
            if marker_elapsed < minimum_elapsed or marker_elapsed > maximum_elapsed:
                continue
            marker_x = x_coordinate(marker_elapsed)
            label = html.escape(f"Epoch {marker.epoch} complete")
            label_y = top + 18 + (index % 3) * 15
            elements.extend(
                [
                    f'<line data-epoch="{html.escape(marker.epoch, quote=True)}" x1="{marker_x:.2f}" y1="{top}" '
                    f'x2="{marker_x:.2f}" y2="{cpu_bottom}" stroke="#7c3aed" stroke-width="1.5" stroke-dasharray="4 4"/>',
                    f'<text class="marker-label" x="{marker_x + 4:.2f}" y="{label_y}">{label}</text>',
                ]
            )

    elements.extend(
        [
            f'<line x1="{left + 15}" y1="{memory_bottom + 30}" x2="{left + 55}" y2="{memory_bottom + 30}" stroke="#2563eb" stroke-width="3"/>',
            f'<text x="{left + 65}" y="{memory_bottom + 35}" font-size="14">memory.current</text>',
            f'<line x1="{left + 230}" y1="{memory_bottom + 30}" x2="{left + 270}" y2="{memory_bottom + 30}" stroke="#d97706" stroke-width="3" stroke-dasharray="8 6"/>',
            f'<text x="{left + 280}" y="{memory_bottom + 35}" font-size="14">memory.peak (cumulative)</text>',
            f'<line x1="{left + 525}" y1="{memory_bottom + 30}" x2="{left + 565}" y2="{memory_bottom + 30}" stroke="#dc2626" stroke-width="2" stroke-dasharray="10 7"/>',
            f'<text x="{left + 575}" y="{memory_bottom + 35}" font-size="14">Memory limit ({memory_limit_bytes / MIB:.1f} MiB)</text>',
            f'<line x1="{left + 15}" y1="{cpu_top - 25}" x2="{left + 55}" y2="{cpu_top - 25}" stroke="#059669" stroke-width="3"/>',
            f'<text x="{left + 65}" y="{cpu_top - 20}" font-size="14">CPU usage</text>',
            "</svg>",
        ]
    )
    return "\n".join(elements) + "\n"


def render_report(args: argparse.Namespace) -> int:
    if args.memory_limit_bytes < 0:
        raise ValueError("--memory-limit-bytes must not be negative")

    samples = load_samples(args.samples)
    markers = load_epoch_markers(args.traces)
    summary = build_summary(samples, markers, args.memory_limit_bytes)

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(build_svg(samples, markers, args.memory_limit_bytes), encoding="utf-8")
    write_markers(args.markers_output, markers, samples)

    args.summary_output.parent.mkdir(parents=True, exist_ok=True)
    args.summary_output.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    markdown_output = args.summary_output.with_suffix(".md")
    markdown_output.write_text(build_markdown_summary(summary), encoding="utf-8")
    return 0


def positive_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed) or parsed <= 0:
        raise argparse.ArgumentTypeError("must be a finite number greater than zero")
    return parsed


def non_negative_int(value: str) -> int:
    parsed = int(value)
    if parsed < 0:
        raise argparse.ArgumentTypeError("must not be negative")
    return parsed


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="subcommand", required=True)

    run_parser = subparsers.add_parser("run", help="coordinate a monitored child command")
    run_parser.add_argument("--ready-file", type=Path, required=True)
    run_parser.add_argument("--finished-file", type=Path, required=True)
    run_parser.add_argument("--ack-file", type=Path, required=True)
    run_parser.add_argument("command", nargs=argparse.REMAINDER)
    run_parser.set_defaults(handler=run_command)

    sample_parser = subparsers.add_parser("sample", help="sample a cgroup v2 directory")
    sample_parser.add_argument("--cgroup", type=Path, required=True)
    sample_parser.add_argument("--output", type=Path, required=True)
    sample_parser.add_argument("--ready-file", type=Path, required=True)
    sample_parser.add_argument("--finished-file", type=Path, required=True)
    sample_parser.add_argument("--ack-file", type=Path, required=True)
    sample_parser.add_argument("--watch-pid", type=int, required=True)
    sample_parser.add_argument("--interval", type=positive_float, required=True)
    sample_parser.set_defaults(handler=sample_cgroup)

    render_parser = subparsers.add_parser("render", help="render samples and JSON traces to an SVG report")
    render_parser.add_argument("--samples", type=Path, required=True)
    render_parser.add_argument("--traces", type=Path, required=True)
    render_parser.add_argument("--output", type=Path, required=True)
    render_parser.add_argument("--markers-output", type=Path, required=True)
    render_parser.add_argument("--summary-output", type=Path, required=True)
    render_parser.add_argument("--memory-limit-bytes", type=non_negative_int, required=True)
    render_parser.set_defaults(handler=render_report)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        return args.handler(args)
    except (OSError, RuntimeError, ValueError) as error:
        print(f"bootstrap-resource-report: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 128 + signal.SIGINT


if __name__ == "__main__":
    sys.exit(main())
