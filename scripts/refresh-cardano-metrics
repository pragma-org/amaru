# Refresh the checked-in cardano-node metric inventory from a local node.
# Run a synced cardano-node with Prometheus enabled, then run this script and
# review the resulting diff before committing it.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CARDANO_URL="http://localhost:12798/metrics"
CONFIG="$SCRIPT_DIR/compare-metrics.json"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --url) CARDANO_URL="$2"; shift 2 ;;
    --config) CONFIG="$2"; shift 2 ;;
    -h|--help)
      printf 'Usage: %s [--url CARDANO_METRICS_URL] [--config METRICS_JSON]\n' "$0"
      exit 0
      ;;
    *) printf 'unknown option: %s\n' "$1" >&2; exit 1 ;;
  esac
done

command -v jq >/dev/null 2>&1 || { printf 'error: jq is required but not found in PATH\n' >&2; exit 1; }
if [[ ! -f "$CONFIG" ]]; then
  printf 'error: metrics config not found: %s\n' "$CONFIG" >&2
  exit 1
fi
if ! jq -e '
  def string_array:
    type == "array"
    and all(.[]; type == "string" and length > 0)
    and (length == (unique | length));
  type == "object"
  and (.all_metrics | string_array)
  and (.supported_metrics | string_array)
' "$CONFIG" >/dev/null; then
  printf 'error: %s must contain unique string arrays "all_metrics" and "supported_metrics"\n' "$CONFIG" >&2
  exit 1
fi

tmp_dir="$(mktemp -d)"
tmp_output=""
cleanup() {
  rm -rf "$tmp_dir"
  [[ -z "$tmp_output" ]] || rm -f "$tmp_output"
}
trap cleanup EXIT

curl -fsSL --max-time 30 -A 'amaru-refresh-cardano-metrics/1.0' "$CARDANO_URL" -o "$tmp_dir/metrics"
if ! awk '
  BEGIN {
    name = "[a-zA-Z_:][a-zA-Z0-9_:]*"
    quoted = "\"([^\"\\\\]|\\\\[\\\\\"n])*\""
    label = "[a-zA-Z_][a-zA-Z0-9_]*[ \t]*=[ \t]*" quoted
    labels = "[{][ \t]*(" label "([ \t]*,[ \t]*" label ")*[ \t]*,?)?[}]"
    value = "([-+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][-+]?[0-9]+)?|NaN|[+-]?Inf)"
    sample = "^[ \t]*" name "(" labels ")?[ \t]+" value "([ \t]+[+-]?[0-9]+)?[ \t]*$"
  }
  /^[[:space:]]*(#|$)/ { next }
  {
    if ($0 !~ sample) exit 1
    metric = $0
    sub(/^[ \t]*/, "", metric)
    sub(/[{ \t].*$/, "", metric)
    print metric
  }
' "$tmp_dir/metrics" | sort -u > "$tmp_dir/names"; then
  printf 'error: %s returned malformed Prometheus samples\n' "$CARDANO_URL" >&2
  exit 1
fi

if [[ ! -s "$tmp_dir/names" ]] || ! awk '/^cardano_node_metrics_/ { found = 1 } END { exit !found }' "$tmp_dir/names"; then
  printf 'error: %s did not expose cardano-node metric samples\n' "$CARDANO_URL" >&2
  exit 1
fi

jq -r '.supported_metrics[] | select(startswith("cardano_node_metrics_"))' "$CONFIG" | sort -u > "$tmp_dir/promised"
comm -23 "$tmp_dir/promised" "$tmp_dir/names" > "$tmp_dir/missing"
if [[ -s "$tmp_dir/missing" ]]; then
  printf 'error: %s is missing promised cardano-node metric samples:\n' "$CARDANO_URL" >&2
  sed 's/^/  /' "$tmp_dir/missing" >&2
  exit 1
fi

tmp_output="$(mktemp "${CONFIG}.tmp.XXXXXX")"
jq -n --rawfile names "$tmp_dir/names" --slurpfile current "$CONFIG" '
  $current[0] | .all_metrics = ($names | split("\n") | map(select(length > 0)) | unique)
' > "$tmp_output"
mv "$tmp_output" "$CONFIG"
tmp_output=""
printf 'Updated %s with %s metric names from %s\n' "$CONFIG" "$(wc -l < "$tmp_dir/names" | tr -d ' ')" "$CARDANO_URL"
