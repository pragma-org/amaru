# Compare Prometheus metrics exposed by a cardano-node against those exposed by
# Amaru.  Produces a JSON report of metrics present in cardano-node but missing
# from Amaru, after applying configurable ignore rules to both sides.
#
# Usage:
#   scripts/compare-metrics [options]
#
# Options:
#   --cardano-url URL   cardano-node /metrics URL   (default: http://localhost:12798/metrics)
#   --amaru-url   URL   Amaru OTLP /metrics URL     (default: http://localhost:8889/metrics)
#   --config      PATH  JSON config file            (default: <script-dir>/compare-metrics.json)
#   --output      PATH  Write JSON report to file   (default: stdout)
#   --summary           Write a Markdown summary to $GITHUB_STEP_SUMMARY (or stderr outside CI)
#   -h, --help          Show this help message

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CARDANO_URL="http://localhost:12798/metrics"
AMARU_URL="http://localhost:8889/metrics"
CONFIG="$SCRIPT_DIR/compare-metrics.json"
OUTPUT=""
SUMMARY=false

# ── argument parsing ──────────────────────────────────────────────────────────

while [[ $# -gt 0 ]]; do
  case "$1" in
    --cardano-url) CARDANO_URL="$2"; shift 2 ;;
    --amaru-url)   AMARU_URL="$2";   shift 2 ;;
    --config)      CONFIG="$2";      shift 2 ;;
    --output)      OUTPUT="$2";      shift 2 ;;
    --summary)     SUMMARY=true;     shift   ;;
    -h|--help)
      grep '^#' "$0" | sed -n '/^# Usage:/,/^# *$/p' | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) printf 'unknown option: %s\n' "$1" >&2; exit 1 ;;
  esac
done

# ── prerequisites ─────────────────────────────────────────────────────────────

command -v jq   >/dev/null 2>&1 || { printf 'error: jq is required but not found in PATH\n'   >&2; exit 1; }
command -v curl >/dev/null 2>&1 || { printf 'error: curl is required but not found in PATH\n' >&2; exit 1; }

# ── helpers ───────────────────────────────────────────────────────────────────

# Fetch all metric names from a Prometheus /metrics endpoint, one per line, sorted.
fetch_metrics() {
  local url="$1" tmp
  tmp=$(mktemp)
  if ! curl -fsSL --max-time 15 -A 'amaru-compare-metrics/1.0' "$url" -o "$tmp"; then
    printf 'error: could not reach %s\n' "$url" >&2
    rm -f "$tmp"
    exit 1
  fi
  # Skip comment / blank lines; strip labels and sample value to keep the metric name only.
  awk '!/^[[:space:]]*(#|$)/ { sub(/[{, ].*/, ""); print }' "$tmp" | sort -u
  rm -f "$tmp"
}

# Filter a sorted metrics file using the ignore rules from the config JSON.
apply_ignore_rules() {
  local file="$1" names_pattern prefix_pattern result

  if [[ -f "$CONFIG" ]]; then
    names_pattern=$(jq  -r '.ignore_metrics  // [] | map("^" + . + "$") | join("|")' "$CONFIG")
    prefix_pattern=$(jq -r '.ignore_prefixes // [] | map("^" + .)        | join("|")' "$CONFIG")
  else
    names_pattern=""
    prefix_pattern=""
  fi

  result=$(cat "$file")
  [[ -n "$names_pattern"  ]] && result=$(printf '%s\n' "$result" | grep -vE "$names_pattern"  || true)
  [[ -n "$prefix_pattern" ]] && result=$(printf '%s\n' "$result" | grep -vE "$prefix_pattern" || true)
  printf '%s\n' "$result"
}

# Portable line count — macOS wc -l pads output with spaces.
count_lines() { wc -l < "$1" | tr -d ' '; }

# ── fetch ─────────────────────────────────────────────────────────────────────

printf 'Fetching cardano-node metrics from %s…\n' "$CARDANO_URL" >&2
cardano_tmp=$(mktemp)
fetch_metrics "$CARDANO_URL" > "$cardano_tmp"

printf 'Fetching Amaru metrics from %s…\n' "$AMARU_URL" >&2
amaru_tmp=$(mktemp)
fetch_metrics "$AMARU_URL" > "$amaru_tmp"

# ── filter + diff ─────────────────────────────────────────────────────────────

filtered_cardano_tmp=$(mktemp)
apply_ignore_rules "$cardano_tmp" > "$filtered_cardano_tmp"

filtered_amaru_tmp=$(mktemp)
apply_ignore_rules "$amaru_tmp" > "$filtered_amaru_tmp"

missing_tmp=$(mktemp)
# comm -23: lines present in file1 (filtered cardano) but absent in file2 (filtered amaru).
comm -23 "$filtered_cardano_tmp" "$filtered_amaru_tmp" > "$missing_tmp"

cardano_total=$(count_lines "$cardano_tmp")
cardano_filtered=$(count_lines "$filtered_cardano_tmp")
amaru_total=$(count_lines "$amaru_tmp")
missing_count=$(count_lines "$missing_tmp")

# ── JSON report ───────────────────────────────────────────────────────────────

json=$(jq -n \
  --argjson cardano_total    "$cardano_total" \
  --argjson cardano_filtered "$cardano_filtered" \
  --argjson amaru_total      "$amaru_total" \
  --argjson missing_count    "$missing_count" \
  --rawfile  missing_raw     "$missing_tmp" \
  '{
    cardano_total:    $cardano_total,
    cardano_filtered: $cardano_filtered,
    amaru_total:      $amaru_total,
    missing_count:    $missing_count,
    missing: ($missing_raw | split("\n") | map(select(. != "")))
  }')

if [[ -n "$OUTPUT" ]]; then
  printf '%s\n' "$json" > "$OUTPUT"
  printf 'Report written to %s\n' "$OUTPUT" >&2
else
  printf '%s\n' "$json"
fi

# ── Markdown summary ──────────────────────────────────────────────────────────

if $SUMMARY; then
  [[ "$missing_count" -eq 0 ]] && status='✅' || status='⚠️'

  summary_tmp=$(mktemp)
  {
    printf '## %s Metrics Coverage Report\n\n' "$status"
    printf '| | Count |\n'
    printf '|---|---:|\n'
    printf '| Cardano node metrics (total) | %s |\n'              "$cardano_total"
    printf '| Cardano node metrics (after ignore rules) | %s |\n' "$cardano_filtered"
    printf '| Amaru metrics (total) | %s |\n'                     "$amaru_total"
    printf '| **Missing in Amaru** | **%s** |\n\n'                "$missing_count"

    if [[ "$missing_count" -gt 0 ]]; then
      printf '<details>\n'
      printf '<summary>Missing metrics (%s)</summary>\n\n' "$missing_count"
      printf '| Metric |\n'
      printf '|--------|\n'
      awk '{ printf "| `%s` |\n", $0 }' "$missing_tmp"
      printf '\n</details>\n\n'
    fi
  } > "$summary_tmp"

  if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
    cat "$summary_tmp" >> "$GITHUB_STEP_SUMMARY"
  else
    cat "$summary_tmp" >&2
  fi

  rm -f "$summary_tmp"
fi

rm -f "$cardano_tmp" "$amaru_tmp" "$filtered_cardano_tmp" "$filtered_amaru_tmp" "$missing_tmp"
