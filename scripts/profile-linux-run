        "rss_bytes": {"max": rss_max, "mean": mean(rss_values)},
        "rss_anon_bytes": {"max": rss_anon_max, "mean": mean(rss_anon_values)},
        "private_bytes": {"max": private_max, "mean": mean(private_values)},
        "heap_live_bytes": {"max": heap_live_max, "mean": mean(heap_live_values)},
        "heap_peak_bytes": {"max": heap_peak_max, "mean": mean(heap_peak_values)},
        "cpu_percent": {"max": maximum(cpu_values), "mean": mean(cpu_values)},
