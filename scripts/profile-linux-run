  "${samples_file}" using 2:(column("cpu_percent")) with lines linewidth 2 title "CPU %" axes x1y2
EOF
fi

watcher_summary="$(python3 - "$epoch_file" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
if not path.exists():
    print("0")
else:
    print(json.loads(path.read_text()).get("observed_epoch_transitions", 0))
PY
)"

if [ "$amaru_status" -eq 130 ] && [ "$watcher_summary" -ge "$epochs" ]; then
  amaru_status=0
fi

printf 'wrote %s\n' "$samples_file"
printf 'wrote %s\n' "$stage_file"
printf 'wrote %s\n' "$summary_json"
printf 'wrote %s\n' "$summary_md"
if [ -f "$plot_file" ]; then
  printf 'wrote %s\n' "$plot_file"
fi

exit "$amaru_status"
