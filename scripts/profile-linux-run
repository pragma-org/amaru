def paired_stage_summary(points: list[dict[str, str | int | None]], start_stage: str, end_stage: str) -> dict | None:
    starts_by_epoch: dict[str, deque[dict[str, str | int | None]]] = defaultdict(deque)
    pairs = []

    for point in sorted(points, key=lambda point: point["timestamp_ms"]):
        stage = point["stage"]
        epoch = point["epoch"]
        if stage == start_stage:
            starts_by_epoch[epoch].append(point)
        elif stage == end_stage and starts_by_epoch[epoch]:
            start = starts_by_epoch[epoch].popleft()
            if point["timestamp_ms"] >= start["timestamp_ms"]:
                pairs.append((start, point))

    if not pairs:
        return None

    durations_ms = [end["timestamp_ms"] - start["timestamp_ms"] for start, end in pairs]
    heap_live_end = [end["heap_live_bytes"] for _, end in pairs if end["heap_live_bytes"] is not None]
    heap_live_delta = [
        end["heap_live_bytes"] - start["heap_live_bytes"]
        for start, end in pairs
        if start["heap_live_bytes"] is not None and end["heap_live_bytes"] is not None
    ]
    jemalloc_allocated_delta = [
        end["jemalloc_allocated"] - start["jemalloc_allocated"]
        for start, end in pairs
        if start["jemalloc_allocated"] is not None and end["jemalloc_allocated"] is not None
    ]
    jemalloc_resident_delta = [
        end["jemalloc_resident"] - start["jemalloc_resident"]
        for start, end in pairs
        if start["jemalloc_resident"] is not None and end["jemalloc_resident"] is not None
    ]

    return {
        "count": len(pairs),
        "duration_ms": stats_summary(durations_ms),
        "heap_live_end_bytes": stats_summary(heap_live_end),
        "heap_live_delta_bytes": stats_summary(heap_live_delta),
        "jemalloc_allocated_delta_bytes": stats_summary(jemalloc_allocated_delta),
        "jemalloc_resident_delta_bytes": stats_summary(jemalloc_resident_delta),
    }


memory_stage_summary = {
    name: summary
    for name, start_stage, end_stage in stage_intervals
    if (summary := paired_stage_summary(stage_points, start_stage, end_stage)) is not None
}

dhat_path = summary_json_path.parent / "dhat-heap.json"
dhat_summary = None
if dhat_path.exists():
    dhat = json.loads(dhat_path.read_text())
    ftbl = dhat.get("ftbl", [])
    pps = dhat.get("pps", [])

    def frame_summary(pp: dict) -> str:
        indices = pp.get("fs", [])
        frames = [ftbl[index] for index in indices[:3] if isinstance(index, int) and index < len(ftbl)]
        return " > ".join(frames) if frames else "[unknown]"

    peak_pps = sorted(pps, key=lambda pp: int(pp.get("gb", 0)), reverse=True)[:5]
    churn_pps = sorted(pps, key=lambda pp: int(pp.get("tb", 0)) - int(pp.get("gb", 0)), reverse=True)[:5]

    dhat_summary = {
        "peak_bytes": sum(int(pp.get("gb", 0)) for pp in pps),
        "top_peak_cost_centers": [
            {
                "bytes_at_global_peak": int(pp.get("gb", 0)),
                "total_bytes": int(pp.get("tb", 0)),
                "frames": frame_summary(pp),
            }
            for pp in peak_pps
        ],
        "top_churn_cost_centers": [
            {
                "transient_bytes": int(pp.get("tb", 0)) - int(pp.get("gb", 0)),
                "bytes_at_global_peak": int(pp.get("gb", 0)),
                "total_bytes": int(pp.get("tb", 0)),
                "frames": frame_summary(pp),
            }
            for pp in churn_pps
        ],
    }

jemalloc_resident = jemalloc_max.get("jemalloc_resident", 0)
jemalloc_allocated = jemalloc_max.get("jemalloc_allocated", 0)
rss_max = maximum(rss_values) or 0
rss_anon_max = maximum(rss_anon_values) or 0
private_max = maximum(private_values) or 0
heap_live_max = maximum(heap_live_values) or 0
heap_peak_max = maximum(heap_peak_values) or 0

composition = {
    "allocator_resident_share_of_rss": (jemalloc_resident / rss_max) if rss_max and jemalloc_resident else None,
    "allocator_retained_bytes": max(jemalloc_resident - jemalloc_allocated, 0) if jemalloc_resident else None,
    "rocksdb_managed_peak_bytes": (
        rocksdb_max.get("block_cache_usage", 0)
        + rocksdb_max.get("size_all_mem_tables", 0)
        + rocksdb_max.get("estimate_table_readers_mem", 0)
    ),
    "rss_minus_heap_live_peak_bytes": max(rss_max - heap_live_max, 0),
    "rss_minus_private_peak_bytes": max(rss_max - private_max, 0),
    "rss_anon_share_of_rss": (rss_anon_max / rss_max) if rss_max and rss_anon_max else None,
}

summary = {
