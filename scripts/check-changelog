from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

CONFIG_PATH = Path(".changie.yaml")
CHANGES_DIR = Path(".changes")
UNRELEASED_DIR = CHANGES_DIR / "unreleased"
GENERATED_CHANGELOG = "CHANGELOG.md"
RELEASED_VERSION_RE = re.compile(r"^\.changes/v[^/]+\.md$")
BYPASS_LINES = {"no-changelog", "skip-changelog"}
KIND_RE = re.compile(r"^kind:\s*(?P<value>.+?)\s*$")
AREA_RE = re.compile(r"^\s+Area:\s*(?P<value>.+?)\s*$")
ISSUES_RE = re.compile(r"^\s+Issues:\s*(?P<value>.+?)\s*$")
ISSUES_VALUE_RE = re.compile(r"^\d+(\s*,\s*\d+)*$")
REFERENCE_LINK_RE = re.compile(r"\]\[[^\]\n]*\]")
NEW_ENTRY_HINT = (
    "```sh\n"
    "changie new --kind Fixed --custom Area=amaru-ledger --custom Issues=1234 \\\n"
    "  --body 'What operators will observe.'\n"
    "```"
)


@dataclass
class Failure:
    title: str
    message: str
    file: str | None = None


def git(*args: str, check: bool = True) -> str:
    return subprocess.run(
        ["git", *args], check=check, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    ).stdout


def gha_escape(message: str) -> str:
    return message.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")


def emit_annotation(failure: Failure) -> None:
    if os.environ.get("GITHUB_ACTIONS") == "true":
        attrs = ([f"file={failure.file}"] if failure.file else []) + [f"title={failure.title}"]
        print(f"::error {','.join(attrs)}::{gha_escape(failure.message)}")
    else:
        location = f"{failure.file}: " if failure.file else ""
        print(f"ERROR: {location}{failure.message}", file=sys.stderr)


def strip_quotes(value: str) -> str:
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
        return value[1:-1]
    return value


def read_config() -> tuple[set[str], set[str]]:
    """Return the configured kind labels and `Area` enum options from `.changie.yaml`."""
    kinds: set[str] = set()
    areas: set[str] = set()
    in_kinds = in_area = in_options = False
    for line in CONFIG_PATH.read_text().splitlines():
        if not line.startswith(" "):
            in_kinds = line.startswith("kinds:")
            in_area = in_options = False
            continue
        stripped = line.strip()
        if in_kinds and stripped.startswith("- label:"):
            kinds.add(strip_quotes(stripped.removeprefix("- label:").strip()))
        elif stripped.startswith("- key:"):
            in_area = stripped.removeprefix("- key:").strip() == "Area"
            in_options = False
        elif in_area and stripped == "enumOptions:":
            in_options = True
        elif in_options and stripped.startswith("- "):
            areas.add(strip_quotes(stripped[2:].strip()))
        elif in_options:
            in_options = False
    return kinds, areas


def has_override(event: dict | None, base: str, head: str) -> bool:
    texts = [git("log", "--format=%B", f"{base}..{head}", check=False)]
    if event and "pull_request" in event:
        texts.append(str(event["pull_request"].get("body") or ""))
    return any(line.strip().lower() in BYPASS_LINES for text in texts for line in text.splitlines())


def resolve_range(args: argparse.Namespace, event_name: str, event: dict | None) -> tuple[str, str, bool] | None:
    """Return `(base, head, include_worktree)`, or `None` when the event needs no check."""
    if args.base_sha and args.head_sha:
        return args.base_sha, args.head_sha, True
    if event_name == "pull_request" and event is not None:
        return event["pull_request"]["base"]["sha"], event["pull_request"]["head"]["sha"], False
    if event_name in {"push", "workflow_dispatch"}:
        return None
    default_branch = args.default_branch or "main"
    head = git("rev-parse", "HEAD").strip()
    base = git("merge-base", "HEAD", f"origin/{default_branch}", check=False).strip()
    return base or git("rev-parse", "HEAD~1", check=False).strip() or head, head, True


def changed_paths(base: str, head: str, include_worktree: bool) -> dict[str, str]:
    """Map each path changed since the merge base to its git status letter (A, M, D, ...)."""
    merge_base = git("merge-base", base, head, check=False).strip() or base
    diff_args = [merge_base] if include_worktree else [merge_base, head]
    changed: dict[str, str] = {}
    for line in git("diff", "--name-status", "--no-renames", *diff_args).splitlines():
        status, path = line.split("\t", 1)
        changed[path] = status[0]
    if include_worktree:
        for path in git("ls-files", "--others", "--exclude-standard").splitlines():
            changed[path] = "A"
    return changed


def validate_fragment(path: Path, kinds: set[str], areas: set[str], failures: list[Failure]) -> None:
    text = path.read_text()
    kind = area = issues = None
    for line in text.splitlines():
        if match := KIND_RE.match(line):
            kind = strip_quotes(match["value"])
        elif match := AREA_RE.match(line):
            area = strip_quotes(match["value"])
        elif match := ISSUES_RE.match(line):
            issues = strip_quotes(match["value"])

    file = path.as_posix()
    if kind not in kinds:
        failures.append(
            Failure("Invalid kind", f"`kind` must be one of: {', '.join(sorted(kinds))}. Found {kind!r}.", file)
        )
    if issues is not None and not ISSUES_VALUE_RE.match(issues):
        failures.append(
            Failure("Invalid issues", f"`custom.Issues` must be numbers separated by commas. Found {issues!r}.", file)
        )
    if REFERENCE_LINK_RE.search(text):
        failures.append(
            Failure(
                "Reference-style link",
                "Reference-style links like `[#123][]` have no definition in the generated changelog. "
                "Put issue and PR numbers in `custom.Issues`, or use an inline link.",
                file,
            )
        )
    if area is None:
        failures.append(Failure("Missing area", "`custom.Area` must name the crate(s) the entry is about.", file))
        return
    unknown = [name for name in (piece.strip() for piece in area.split(",")) if name not in areas]
    if unknown:
        failures.append(
            Failure(
                "Unknown area",
                f"Unknown crate(s) in `custom.Area`: {', '.join(unknown)}. "
                "Add new crates to the `Area` enumOptions in .changie.yaml.",
                file,
            )
        )


def validate_with_changie(failures: list[Failure]) -> None:
    changie = shutil.which("changie")
    if changie is None:
        if os.environ.get("GITHUB_ACTIONS") == "true":
            failures.append(Failure("Missing changie", "changie must be installed to validate fragments."))
        else:
            print("NOTE: changie is not installed; CI will check that every fragment renders.", file=sys.stderr)
        return
    result = subprocess.run(
        [changie, "batch", "v0.0.0", "--dry-run"], text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    if result.returncode != 0:
        failures.append(Failure("Fragment does not render", f"`changie batch --dry-run` failed:\n{result.stderr.strip()}"))


def check(changed: dict[str, str], kinds: set[str], areas: set[str], *, require_entry: bool) -> list[Failure]:
    failures: list[Failure] = []

    for path, status in sorted(changed.items()):
        if path == GENERATED_CHANGELOG:
            failures.append(
                Failure(
                    "Generated file edited",
                    f"{path} is regenerated by `changie merge` at release time, so edits to it are lost. "
                    "Add or edit a fragment in .changes/unreleased/ instead.",
                    path,
                )
            )
        elif RELEASED_VERSION_RE.match(path) and status != "A":
            failures.append(
                Failure(
                    "Released version edited",
                    f"{path} holds the notes of a published release. "
                    "Add or edit a fragment in .changes/unreleased/ instead.",
                    path,
                )
            )

    touched_fragments = sorted(
        Path(path) for path in changed if Path(path).parent == UNRELEASED_DIR and Path(path).exists()
    )
    for fragment in touched_fragments:
        if fragment.suffix != ".yaml":
            failures.append(
                Failure("Ignored fragment", "changie only reads `.yaml` files, so this entry would be dropped.", str(fragment))
            )
        else:
            validate_fragment(fragment, kinds, areas, failures)

    if not touched_fragments and require_entry:
        failures.append(
            Failure(
                "Missing changelog entry",
                f"Crate changes require a changelog fragment in {UNRELEASED_DIR}/. Create one with:\n\n{NEW_ENTRY_HINT}",
            )
        )
    elif touched_fragments and not failures:
        validate_with_changie(failures)

    return failures


def report_markdown(failures: list[Failure]) -> str:
    items = []
    for failure in failures:
        location = f"`{failure.file}`: " if failure.file else ""
        first, *rest = failure.message.splitlines() or [""]
        items.append("\n".join([f"- **{failure.title}**: {location}{first}", *(f"  {line}" for line in rest)]))
    return (
        "## Changelog check failed\n\n"
        + "\n".join(items)
        + "\n\n> [!TIP]\n"
        "> Nothing relevant to add to the changelog? Add `Skip-Changelog` to one of your commit messages "
        "or to the PR description.\n"
    )


def publish_report(report_file: str | None, report: str) -> None:
    if report_file:
        Path(report_file).write_text(report, encoding="utf-8")
    if summary := os.environ.get("GITHUB_STEP_SUMMARY"):
        Path(summary).write_text(report, encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--report-file")
    parser.add_argument("--base-sha")
    parser.add_argument("--head-sha")
    parser.add_argument("--default-branch")
    args = parser.parse_args()

    event_name = os.environ.get("GITHUB_EVENT_NAME", "")
    event_path = os.environ.get("GITHUB_EVENT_PATH")
    event = json.loads(Path(event_path).read_text()) if event_path else None

    try:
        resolved = resolve_range(args, event_name, event)
        if resolved is None:
            print(f"Ignoring changelog check for GitHub event '{event_name}'.")
            return 0
        base, head, include_worktree = resolved
        override = has_override(event, base, head)
        if override:
            print("Skip-Changelog override: a new fragment is not required.")
        kinds, areas = read_config()
        failures = check(changed_paths(base, head, include_worktree), kinds, areas, require_entry=not override)
    except Exception as exc:
        failures = [Failure("Unexpected failure", f"check-changelog failed unexpectedly: {exc}")]

    if not failures:
        print("Changelog fragments pass validation.")
        return 0
    for failure in failures:
        emit_annotation(failure)
    publish_report(args.report_file, report_markdown(failures))
    return 1


if __name__ == "__main__":
    sys.exit(main())
