from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path


RELEASED_HEADER_RE = re.compile(r"^## \[(v\d+\.\d+\.\d{8})\]\(([^)]+)\)$")
SECTION_RE = re.compile(r"^### (Added|Changed|Deprecated|Removed|Fixed|Security)$")
REF_DEF_RE = re.compile(r"^\[(#\d+)\]: (.+)$")


def unreleased_range(lines: list[str]) -> tuple[int, int]:
    matches = [idx for idx, line in enumerate(lines) if line == "## Unreleased"]
    if len(matches) != 1:
        raise ValueError("Expected exactly one ## Unreleased heading")
    start = matches[0]
    end = next(
        (
            idx for idx in range(start + 1, len(lines))
            if lines[idx].startswith("## ") or REF_DEF_RE.match(lines[idx])
        ),
        len(lines),
    )
    return start, end


def parse_entries(lines: list[str]) -> dict[str, list[str]]:
    sections: dict[str, list[str]] = {}
    entries: list[str] | None = None
    for line in lines:
        section = SECTION_RE.match(line)
        if section:
            if section[1] in sections:
                raise ValueError(f"Duplicate section: {section[1]}")
            entries = sections.setdefault(section[1], [])
        elif line.startswith("- ") and entries is not None:
            entries.append(line.rstrip())
        elif entries and (not line.strip() or line.startswith(" ")):
            entries[-1] += "\n" + line.rstrip()
        elif line.strip():
            raise ValueError(f"Cannot safely move changelog content: {line}")
    return {name: [entry.strip() for entry in entries] for name, entries in sections.items()}


def render_sections(sections: dict[str, list[str]]) -> list[str]:
    lines: list[str] = []
    for name, entries in sections.items():
        if entries:
            lines.extend([f"### {name}", ""])
            for entry in entries:
                lines.extend(entry.splitlines())
            lines.append("")
    return lines


def update_changelog(current: str, snapshot: str, version: str, release_tag: str, repo: str) -> str:
    """Move the tag's pending entries, refusing to guess when their wording has changed."""
    lines = current.splitlines()
    release_version = f"v{version}"
    versions = [match[1] for line in lines if (match := RELEASED_HEADER_RE.match(line))]
    if release_version in versions:
        return current
    if any(version[-8:] > release_version[-8:] for version in versions):
        raise ValueError("Finalize releases in chronological order")

    start, end = unreleased_range(lines)
    pending = parse_entries(lines[start + 1 : end])
    tagged_lines = snapshot.splitlines()
    tagged_start, tagged_end = unreleased_range(tagged_lines)
    released = parse_entries(tagged_lines[tagged_start + 1 : tagged_end])
    released_entries = {entry for entries in released.values() for entry in entries}
    pending_entries = {entry for entries in pending.values() for entry in entries}
    missing = released_entries - pending_entries
    if missing:
        raise ValueError(
            "Tagged entries were edited or removed from Unreleased; reconcile them before retrying:\n"
            + "\n".join(sorted(missing))
        )
    remaining = {
        name: [entry for entry in entries if entry not in released_entries]
        for name, entries in pending.items()
    }
    release_header = f"## [{release_version}](https://github.com/{repo}/releases/tag/{release_tag})"
    references = {match[1]: line for line in lines if (match := REF_DEF_RE.match(line))}
    used_references = set(re.findall(r"\[(#\d+)\]\[\]", "\n".join(released_entries)))
    if any(label not in references or references[label] not in tagged_lines for label in used_references):
        raise ValueError("Tagged reference definitions are missing or changed")
    return "\n".join(
        lines[: start + 1] + [""] + render_sections(remaining)
        + [release_header, ""] + render_sections(released) + lines[end:]
    ).rstrip() + "\n"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--version", required=True)
    parser.add_argument("--release-tag", required=True)
    parser.add_argument("--repo", default="pragma-org/amaru")
    parser.add_argument("--changelog", default="CHANGELOG.md")
    parser.add_argument("--release-changelog", required=True, help="Changelog read from the release tag")
    args = parser.parse_args()

    try:
        changelog_path = Path(args.changelog)
        current = changelog_path.read_text(encoding="utf-8")
        snapshot = Path(args.release_changelog).read_text(encoding="utf-8")
        updated = update_changelog(current, snapshot, args.version, args.release_tag, args.repo)
        changelog_path.write_text(updated, encoding="utf-8")
    except (OSError, ValueError) as err:
        print(f"error: failed to update changelog: {err}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
