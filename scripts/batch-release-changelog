"""Batch the changelog fragments present at a release tag into that release's notes.

Fragments added after the tag stay in `.changes/unreleased/` for the next release.
The tag must be available locally, e.g. `git fetch --depth=1 origin tag <tag>`.
"""

from __future__ import annotations

import argparse
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

CHANGES_DIR = Path(".changes")
UNRELEASED_DIR = CHANGES_DIR / "unreleased"


def git(*args: str) -> str:
    return subprocess.run(["git", *args], check=True, text=True, stdout=subprocess.PIPE).stdout


def tagged_fragments(release_tag: str) -> dict[str, str]:
    """Map each fragment file name at `release_tag` to its blob id."""
    fragments: dict[str, str] = {}
    for line in git("ls-tree", release_tag, f"{UNRELEASED_DIR}/").splitlines():
        meta, path = line.split("\t", 1)
        if path.endswith(".yaml"):
            fragments[Path(path).name] = meta.split()[2]
    return fragments


def batch(release_tag: str, changie: str) -> None:
    if (CHANGES_DIR / f"{release_tag}.md").exists():
        print(f"{release_tag} is already batched.")
        return

    tagged = tagged_fragments(release_tag)
    current = {path.name: path for path in UNRELEASED_DIR.glob("*.yaml")}

    removed = sorted(name for name in tagged if name not in current)
    edited = sorted(
        name
        for name, blob in tagged.items()
        if name in current and git("hash-object", str(current[name])).strip() != blob
    )
    if removed or edited:
        raise ValueError(
            f"Fragments released in {release_tag} were changed afterwards; reconcile them before retrying:\n"
            + "\n".join([*(f"removed: {name}" for name in removed), *(f"edited: {name}" for name in edited)])
        )

    with tempfile.TemporaryDirectory() as held_dir:
        held = [path for name, path in current.items() if name not in tagged]
        for path in held:
            shutil.move(path, Path(held_dir) / path.name)
        try:
            subprocess.run([changie, "batch", release_tag], check=True)
            subprocess.run([changie, "merge"], check=True)
        finally:
            for path in held:
                shutil.move(Path(held_dir) / path.name, path)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--release-tag", required=True)
    parser.add_argument("--changie", default="changie")
    args = parser.parse_args()

    try:
        batch(args.release_tag, args.changie)
    except (OSError, ValueError, subprocess.CalledProcessError) as err:
        print(f"error: failed to batch the changelog: {err}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
