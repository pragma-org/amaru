#!/usr/bin/env bash
# Find schema constants (from dump-traces-schema JSON) never referenced in debug_span! calls.
#
# Private schemas (public: false) are included in the registry so they appear here too.

set -euo pipefail

BUILD_PROFILE="${BUILD_PROFILE:-test}"

# Get all schema paths from the compiled registry (both public and private)
all_paths=$(cargo run --quiet --profile $BUILD_PROFILE dump-traces-schema 2>&1 | jq -r '.definitions | keys[]' | sort)

total=$(echo "$all_paths" | wc -l | tr -d ' ')
unused=0

# Single pass: extract all multi-segment ::path::CONSTANT references from source.
# Exclude amaru-observability itself (schema definitions and macro doc comments
# would trivially match their own paths and produce false "used" results).
used=$(find crates -name "*.rs" \
    -not -path "*/target/*" \
    -not -path "*/amaru-observability/*" \
    | xargs grep -ohE '([a-z_][a-z0-9_]*::)+[A-Z][A-Z0-9_]+' 2>/dev/null \
    | sort -u)

# Schema keys are fully qualified with a leading `amaru::`, but call sites
# typically use crate-relative paths (e.g. `ledger::state::block::APPLY`).
# Match against the suffix so both forms count as used.
while IFS= read -r path; do
    suffix=${path#amaru::}
    if ! echo "$used" | grep -qF "$suffix"; then
        echo "UNUSED  $path"
        unused=$((unused + 1))
    fi
done <<< "$all_paths"

echo ""
echo "$unused unused / $total total schema constants"

if [[ $unused -gt 0 ]]; then
    exit 1
fi
