#!/usr/bin/env bash

set -euo pipefail

test_timeout=${TOOL_TEST_TIMEOUT:-300}
screen_output=$(mktemp)
gliveview_pid=
trap '
  if [[ -n "$gliveview_pid" ]]; then
    kill "$gliveview_pid" 2>/dev/null || true
    wait "$gliveview_pid" 2>/dev/null || true
  fi
  rm -f "$screen_output"
' EXIT
deadline=$((SECONDS + test_timeout))

render_screen_output() {
  sed -E 's/\x1B\[[0-?]*[ -/]*[@-~]//g; s/\x1B[()][A-Z0-9]//g' "$screen_output"
}

# shellcheck disable=SC2016 # GLIVEVIEW_HOME is expanded by the shell launched by script.
GLIVEVIEW_HOME="${GLIVEVIEW_HOME:-/opt/cardano/amaru}" \
  AMARU_BIN="${AMARU_BIN:-$PWD/target/release/amaru}" TERM=xterm \
  timeout "$test_timeout" script --quiet --return \
    --command 'stty rows 60 cols 120 && exec "$GLIVEVIEW_HOME/scripts/gLiveView.sh" -u' \
    /dev/null >"$screen_output" 2>&1 &
gliveview_pid=$!

while (( SECONDS < deadline )); do
  slot=$(
    render_screen_output \
      | sed -nE 's/.*Slot[[:space:]]*:?[[:space:]]*([0-9][0-9,]*).*/\1/p' \
      | tr -d ',' \
      | tail -1
  )
  if [[ "$slot" =~ ^[0-9]+$ ]] && (( slot > 0 )); then
    echo "GLiveView displayed a non-zero slot: $slot"
    exit 0
  fi
  if ! kill -0 "$gliveview_pid" 2>/dev/null; then
    wait "$gliveview_pid" || true
    gliveview_pid=
    echo "GLiveView exited before displaying a non-zero slot."
    render_screen_output | fold -w 120 | tail -50
    exit 1
  fi
  sleep 2
done

echo "GLiveView did not display a non-zero slot within ${test_timeout} seconds."
render_screen_output | fold -w 120 | tail -50
exit 1
