#!/usr/bin/env bash

set -euo pipefail

screen_output=$(mktemp)
trap 'rm -f "$screen_output"' EXIT
test_timeout=${TOOL_TEST_TIMEOUT:-300}
deadline=$((SECONDS + test_timeout))

docker run -dit --network host \
  --name gliveview \
  --env PROM_HOST=127.0.0.1 \
  --env PROM_PORT=8889 \
  gliveview:nightly >/dev/null

while (( SECONDS < deadline )); do
  docker logs gliveview 2>&1 \
    | sed -E 's/\x1B\[[0-9;]*[[:alpha:]]//g' \
    > "$screen_output"
  slot=$(sed -nE 's/.*Slot[[:space:]]*:[[:space:]]*([0-9]+).*/\1/p' "$screen_output" | tail -1)
  if [[ "$slot" =~ ^[0-9]+$ ]] && (( slot > 0 )); then
    echo "GLiveView displayed a non-zero slot: $slot"
    exit 0
  fi
  sleep 2
done

echo "GLiveView did not display a non-zero slot within ${test_timeout} seconds."
tail -50 "$screen_output"
exit 1
