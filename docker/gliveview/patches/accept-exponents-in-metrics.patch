+normalizePrometheusMetrics() {
+  awk '
+    function zeros(count, result) {
+      result = ""
+      while (count-- > 0) {
+        result = result "0"
+      }
+      return result
+    }
+
+    function expandExponent(value, exponentAt, mantissa, exponent, sign, decimalAt, digits, decimalPosition, result) {
+      if (value !~ /^[+-]?[0-9]+(\.[0-9]*)?[eE][+-]?[0-9]+$/) {
+        return value
+      }
+
+      exponentAt = index(tolower(value), "e")
+      mantissa = substr(value, 1, exponentAt - 1)
+      exponent = substr(value, exponentAt + 1) + 0
+      sign = ""
+      if (substr(mantissa, 1, 1) ~ /[+-]/) {
+        sign = substr(mantissa, 1, 1)
+        mantissa = substr(mantissa, 2)
+      }
+
+      decimalAt = index(mantissa, ".")
+      digits = mantissa
+      if (decimalAt > 0) {
+        digits = substr(mantissa, 1, decimalAt - 1) substr(mantissa, decimalAt + 1)
+      } else {
+        decimalAt = length(mantissa) + 1
+      }
+      decimalPosition = decimalAt - 1 + exponent
+
+      if (decimalPosition <= 0) {
+        result = "0." zeros(-decimalPosition) digits
+      } else if (decimalPosition >= length(digits)) {
+        result = digits zeros(decimalPosition - length(digits))
+      } else {
+        result = substr(digits, 1, decimalPosition) "." substr(digits, decimalPosition + 1)
+      }
+      return sign result
+    }
+
+    !/^# / { $NF = expandExponent($NF); print }
+  '
+}
+
 # Description : Query cardano-node for current metrics
