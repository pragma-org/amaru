+# Description : Assign a Prometheus value, converting exponent notation for bash and bc arithmetic
+#             : $1 = variable name, $2 = Prometheus value
+setPrometheusMetric() {
+  local metric=$1 normalized=$2
+  if [[ ${normalized} == *[eE]* ]]; then
+    if LC_NUMERIC=C printf -v normalized "%.15f" "${normalized}"; then
+      while [[ ${normalized} == *.*0 ]]; do normalized=${normalized%0}; done
+      normalized=${normalized%.}
+    else
+      normalized=0
+    fi
+  fi
+  printf -v "${metric}" "%s" "${normalized}"
+}
