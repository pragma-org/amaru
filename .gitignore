# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Default database location for the ledger
/*ledger.*.db/

# Default database location for the consensus
/*chain.*.db/

# Insta not-yet reviewed snapshots
*.snap.new

# Generated conformance fixtures. Fetch/regenerate these through build.rs or
# conformance-tests/haskell-node-extractor/scripts/generate-snap-files.
crates/amaru/tests/**/stake-distributions/**/*.json
crates/amaru/tests/**/stake-distributions/**/*.json.zst
!crates/amaru/tests/**/stake-distributions/**/package.json
!crates/amaru/tests/**/haskell-node-extractor/**/schemas/*.json

# Files downloaded for the demo
/snapshots/

# Files downloaded by mithril
/mithril-snapshots/

# Files for local coverage reports
coverage/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/
*~

# Cardano node support files
/cardano-node-config/

# Peer snapshots staged by crates/amaru/build (not committed; see config/peer-snapshots/README.md)
crates/amaru/config/peer-snapshots/**/peer-snapshot.json
crates/amaru/config/peer-snapshots/**/*.json.tmp
crates/amaru/config/peer-snapshots/CONFIGS_COMMIT

# llvm-cov generated file
lcov.info
.aider*

**/proptest-regressions/**

heaptrack.*.gz

data/**/blocks/**

# Test arguments, generated data and traces created during the simulation
**/amaru-sim/test-data/
**/amaru-uplc/benches/turbo/samples

# Relay demos data
scripts/demos/*/run/**

# Payment signing keys generated for the relay demos; the committed demo keys
# remain tracked, this only prevents committing new ones by accident
scripts/demos/*/keys/**/*.skey

/.opencode/
data/*/epoch-snapshots/

# Packaging and distribution target dir
dist/

# Override any user-level ignore of .flox/ so the project's flox env ships
# with the repo. Build artefacts inside .flox/ (cache/, run/, log/, lib/)
# are filtered by .flox/.gitignore.
!.flox/

# Python scripts
__pycache__
