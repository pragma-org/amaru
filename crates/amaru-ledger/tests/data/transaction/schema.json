{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pragma-org/amaru/blob/main/crates/amaru-ledger/tests/data/transaction/schema.json",
  "title": "Transaction validation fixture",
  "description": "An implementation-generic test vector for Cardano transaction validation, covering both the phase-one rules and phase-two script evaluation.",
  "type": "object",
  "required": [
    "network",
    "eraHistory",
    "protocolParameters",
    "initialState",
    "point",
    "transaction",
    "expected"
  ],
  "properties": {
    "title": { "type": "string" },
    "description": { "type": "string" },
    "network": {
      "type": "string",
      "pattern": "^(mainnet|preprod|preview|testnet_[0-9]+)$"
    },
    "eraHistory": {
      "oneOf": [
        { "$ref": "#/$defs/EraHistory" },
        { "$ref": "#/$defs/RefOrOverride" }
      ],
      "description": "Either an inline EraHistory or a $ref to a shared file under common/eraHistory/."
    },
    "protocolParameters": {
      "oneOf": [
        { "$ref": "#/$defs/ProtocolParameters" },
        { "$ref": "#/$defs/RefOrOverride" }
      ],
      "description": "Either inline ProtocolParameters or a $ref to a shared file under common/protocolParameters/, with an optional $override object that is shallow-merged over the referenced document."
    },
    "initialState": { "$ref": "#/$defs/InitialState" },
    "point": { "$ref": "#/$defs/TransactionPointer" },
    "transaction": {
      "$ref": "#/$defs/HexCbor",
      "description": "Hex-encoded CBOR of the transaction."
    },
    "expected": { "$ref": "#/$defs/Expected" }
  },
  "$defs": {
    "HexCbor": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]+$"
    },
    "RefOrOverride": {
      "type": "object",
      "required": ["$ref"],
      "properties": {
        "$ref": {
          "type": "string",
          "description": "Path to a shared canonical document, relative to the fixture data root (e.g. \"common/protocolParameters/preprod-conway-v10.json\")."
        },
        "$override": {
          "type": "object",
          "description": "Optional object shallow-merged over the referenced document before final deserialization. Use for one-off variations on a shared preset."
        }
      },
      "additionalProperties": false
    },
    "Ratio": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "ExecutionUnits": {
      "type": "object",
      "required": ["memory", "cpu"],
      "properties": {
        "memory": { "type": "integer", "minimum": 0 },
        "cpu": { "type": "integer", "minimum": 0 }
      }
    },
    "ProtocolVersion": {
      "type": "object",
      "required": ["major", "minor"],
      "properties": {
        "major": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 }
      }
    },
    "EraName": {
      "type": "string",
      "enum": [
        "Byron",
        "Shelley",
        "Allegra",
        "Mary",
        "Alonzo",
        "Babbage",
        "Conway"
      ]
    },
    "EraBound": {
      "type": "object",
      "required": ["time", "slot", "epoch"],
      "properties": {
        "time": {
          "type": "integer",
          "minimum": 0,
          "description": "Seconds since system start."
        },
        "slot": { "type": "integer", "minimum": 0 },
        "epoch": { "type": "integer", "minimum": 0 }
      }
    },
    "EraParams": {
      "type": "object",
      "required": ["epochSizeSlots", "slotLengthMs", "eraName"],
      "properties": {
        "epochSizeSlots": { "type": "integer", "minimum": 1 },
        "slotLengthMs": { "type": "integer", "minimum": 1 },
        "eraName": { "$ref": "#/$defs/EraName" }
      }
    },
    "EraSummary": {
      "type": "object",
      "required": ["start", "end", "params"],
      "properties": {
        "start": { "$ref": "#/$defs/EraBound" },
        "end": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/EraBound" }]
        },
        "params": { "$ref": "#/$defs/EraParams" }
      }
    },
    "EraHistory": {
      "type": "object",
      "required": ["stabilityWindow", "eras"],
      "properties": {
        "stabilityWindow": { "type": "integer", "minimum": 0 },
        "eras": {
          "type": "array",
          "items": { "$ref": "#/$defs/EraSummary" }
        }
      }
    },
    "TransactionPointer": {
      "type": "object",
      "required": ["slot", "transactionIndex"],
      "properties": {
        "slot": { "type": "integer", "minimum": 0 },
        "transactionIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "ProposalId": {
      "type": "object",
      "required": ["transactionId", "proposalIndex"],
      "properties": {
        "transactionId": { "type": "string", "description": "Hex-encoded 32-byte hash of the transaction that submitted the governance action." },
        "proposalIndex": { "type": "integer", "minimum": 0, "description": "Index of the governance action within that transaction." }
      }
    },
    "UtxoEntry": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input": {
          "$ref": "#/$defs/HexCbor",
          "description": "Hex-encoded CBOR of TransactionInput."
        },
        "output": {
          "$ref": "#/$defs/HexCbor",
          "description": "Hex-encoded CBOR of the transaction output."
        }
      }
    },
    "VotingState": {
      "type": "object",
      "required": ["consecutiveDormantEpochs"],
      "properties": {
        "consecutiveDormantEpochs": { "type": "integer", "minimum": 0 }
      }
    },
    "PoolId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{56}$",
      "description": "Hex-encoded stake pool key hash (28 bytes)."
    },
    "ScriptHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{56}$",
      "description": "Hex-encoded script hash (28 bytes)."
    },
    "VrfKeyHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$",
      "description": "Hex-encoded VRF verification key hash (32 bytes)."
    },
    "Pool": {
      "type": "object",
      "required": ["id", "vrf"],
      "properties": {
        "id": { "$ref": "#/$defs/PoolId" },
        "vrf": {
          "$ref": "#/$defs/VrfKeyHash",
          "description": "The pool's current (active) VRF key hash."
        },
        "pendingVrf": {
          "$ref": "#/$defs/VrfKeyHash",
          "description": "A pending re-registration's not-yet-activated VRF key hash."
        }
      },
      "additionalProperties": false
    },
    "CertificatePointer": {
      "type": "object",
      "required": ["transaction", "certificateIndex"],
      "properties": {
        "transaction": { "$ref": "#/$defs/TransactionPointer" },
        "certificateIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "PoolDelegation": {
      "type": "object",
      "required": ["id", "delegatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/PoolId" },
        "delegatedAt": { "$ref": "#/$defs/CertificatePointer" }
      }
    },
    "VoteDelegation": {
      "type": "object",
      "required": ["id", "delegatedAt"],
      "properties": {
        "id": {
          "$ref": "#/$defs/HexCbor",
          "description": "Hex-encoded CBOR of DRep."
        },
        "delegatedAt": { "$ref": "#/$defs/CertificatePointer" }
      }
    },
    "Account": {
      "type": "object",
      "required": ["credential", "deposit"],
      "properties": {
        "credential": {
          "$ref": "#/$defs/HexCbor",
          "description": "Hex-encoded CBOR of StakeCredential."
        },
        "deposit": {
          "type": "integer",
          "minimum": 0,
          "description": "Lovelace held as the registration deposit; refunded on deregistration."
        },
        "rewards": {
          "type": "integer",
          "minimum": 0,
          "description": "Lovelace. Withdrawable reward balance. Defaults to 0."
        },
        "pool": { "$ref": "#/$defs/PoolDelegation" },
        "drep": { "$ref": "#/$defs/VoteDelegation" }
      }
    },
    "DRepRegistration": {
      "type": "object",
      "required": ["credential", "deposit", "registeredAt", "validUntil"],
      "properties": {
        "credential": {
          "$ref": "#/$defs/HexCbor",
          "description": "Hex-encoded CBOR of StakeCredential."
        },
        "deposit": {
          "type": "integer",
          "minimum": 0,
          "description": "Lovelace held as the registration deposit; refunded on deregistration."
        },
        "registeredAt": { "$ref": "#/$defs/CertificatePointer" },
        "validUntil": {
          "type": "integer",
          "minimum": 0,
          "description": "Epoch through which the registration is valid."
        }
      }
    },
    "CommitteeMember": {
      "type": "object",
      "required": ["coldCredential"],
      "properties": {
        "coldCredential": {
          "$ref": "#/$defs/HexCbor",
          "description": "Hex-encoded CBOR of StakeCredential. The cold credential keying the member."
        },
        "status": {
          "oneOf": [
            {
              "$ref": "#/$defs/HexCbor",
              "description": "Hex-encoded CBOR of a hot StakeCredential the member has delegated to."
            },
            {
              "type": "string",
              "enum": ["resigned"]
            }
          ]
        },
        "validUntil": {
          "type": "integer",
          "minimum": 0,
          "description": "Epoch through which the member's term runs. Absent for a member holding no term, which is still a state a member can authorize a hot credential from."
        }
      }
    },
    "InitialState": {
      "type": "object",
      "properties": {
        "utxo": {
          "type": "array",
          "items": { "$ref": "#/$defs/UtxoEntry" }
        },
        "pools": {
          "type": "array",
          "items": {
            "oneOf": [{ "$ref": "#/$defs/PoolId" }, { "$ref": "#/$defs/Pool" }]
          },
          "description": "Registered stake pools, as bare pool key hashes or objects carrying the pool's VRF key hashes. Empty when no pool state is seeded."
        },
        "accounts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Account" },
          "description": "Registered stake accounts. Empty when no account state is seeded."
        },
        "dreps": {
          "type": "array",
          "items": { "$ref": "#/$defs/DRepRegistration" },
          "description": "Registered delegate representatives. Empty when no DRep state is seeded."
        },
        "committee": {
          "type": "array",
          "items": { "$ref": "#/$defs/CommitteeMember" },
          "description": "Constitutional committee members, keyed by cold credential. Empty when no committee state is seeded."
        },
        "proposals": {
          "type": "array",
          "items": { "$ref": "#/$defs/ProposalEntry" },
          "description": "In-flight governance proposals seeding the block-start proposal set. Empty when none are seeded."
        },
        "proposalsRoots": {
          "$ref": "#/$defs/ProposalsRoots",
          "description": "The latest enacted governance action id per purpose. Absent purposes default to none."
        },
        "governanceActivity": { "$ref": "#/$defs/VotingState" },
        "pots": { "$ref": "#/$defs/Pots" },
        "guardrailScript": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ScriptHash" }],
          "description": "Guardrails script of the enacted constitution. A proposal carrying a policy must name exactly this script; absent or null requires proposals to carry no policy at all."
        }
      }
    },
    "Pots": {
      "type": "object",
      "description": "Protocol pots as of the initial state.",
      "properties": {
        "treasury": { "type": "integer", "minimum": 0 },
        "reserves": { "type": "integer", "minimum": 0 }
      }
    },
    "ProposalEntry": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": [
        { "$ref": "#/$defs/ProposalId" },
        { "$ref": "#/$defs/ProposalKind" },
        {
          "type": "integer",
          "minimum": 0,
          "description": "Last epoch a vote on this proposal still counts, i.e. the epoch it was proposed in plus governanceActionLifetime. Required: every proposal on chain has one."
        }
      ]
    },
    "ProposalKind": {
      "type": "string",
      "description": "The lineage a proposal chains onto. 'ProtocolParameters(security-group)' marks an update touching the security group, and a hard fork names the version it would enact.",
      "pattern": "^(ProtocolParameters(\\(security-group\\))?|HardFork\\([0-9]+\\.[0-9]+\\)|ConstitutionalCommittee|Constitution|Orphan|Information|TreasuryWithdrawals)$"
    },
    "ProposalsRoots": {
      "type": "object",
      "properties": {
        "protocolParameters": { "$ref": "#/$defs/ProposalId", "description": "The enacted protocol-parameters root id." },
        "hardFork": { "$ref": "#/$defs/ProposalId", "description": "The enacted hard-fork root id." },
        "constitutionalCommittee": { "$ref": "#/$defs/ProposalId", "description": "The enacted constitutional-committee root id." },
        "constitution": { "$ref": "#/$defs/ProposalId", "description": "The enacted constitution root id." }
      }
    },
    "MinFeeReferenceScripts": {
      "type": "object",
      "required": ["range", "base", "multiplier"],
      "properties": {
        "range": { "type": "integer", "minimum": 0 },
        "base": { "$ref": "#/$defs/Ratio" },
        "multiplier": { "$ref": "#/$defs/Ratio" }
      }
    },
    "PlutusCostModels": {
      "type": "object",
      "properties": {
        "plutusV1": { "type": "array", "items": { "type": "integer" } },
        "plutusV2": { "type": "array", "items": { "type": "integer" } },
        "plutusV3": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "ScriptExecutionPrices": {
      "type": "object",
      "required": ["memory", "cpu"],
      "properties": {
        "memory": { "$ref": "#/$defs/Ratio" },
        "cpu": { "$ref": "#/$defs/Ratio" }
      }
    },
    "CommitteeThresholds": {
      "type": "object",
      "required": ["default", "stateOfNoConfidence"],
      "properties": {
        "default": { "$ref": "#/$defs/Ratio" },
        "stateOfNoConfidence": { "$ref": "#/$defs/Ratio" }
      }
    },
    "StakePoolVotingThresholds": {
      "type": "object",
      "required": [
        "noConfidence",
        "constitutionalCommittee",
        "hardForkInitiation",
        "protocolParametersUpdate"
      ],
      "properties": {
        "noConfidence": { "$ref": "#/$defs/Ratio" },
        "constitutionalCommittee": { "$ref": "#/$defs/CommitteeThresholds" },
        "hardForkInitiation": { "$ref": "#/$defs/Ratio" },
        "protocolParametersUpdate": {
          "type": "object",
          "required": ["security"],
          "properties": {
            "security": { "$ref": "#/$defs/Ratio" }
          }
        }
      }
    },
    "DelegateRepresentativeVotingThresholds": {
      "type": "object",
      "required": [
        "noConfidence",
        "constitution",
        "constitutionalCommittee",
        "hardForkInitiation",
        "protocolParametersUpdate",
        "treasuryWithdrawals"
      ],
      "properties": {
        "noConfidence": { "$ref": "#/$defs/Ratio" },
        "constitution": { "$ref": "#/$defs/Ratio" },
        "constitutionalCommittee": { "$ref": "#/$defs/CommitteeThresholds" },
        "hardForkInitiation": { "$ref": "#/$defs/Ratio" },
        "protocolParametersUpdate": {
          "type": "object",
          "required": ["network", "economic", "technical", "governance"],
          "properties": {
            "network": { "$ref": "#/$defs/Ratio" },
            "economic": { "$ref": "#/$defs/Ratio" },
            "technical": { "$ref": "#/$defs/Ratio" },
            "governance": { "$ref": "#/$defs/Ratio" }
          }
        },
        "treasuryWithdrawals": { "$ref": "#/$defs/Ratio" }
      }
    },
    "ProtocolParameters": {
      "type": "object",
      "required": [
        "minFeeCoefficient",
        "minFeeConstant",
        "minFeeReferenceScripts",
        "minUtxoDepositCoefficient",
        "maxBlockBodySize",
        "maxBlockHeaderSize",
        "maxTransactionSize",
        "maxValueSize",
        "maxReferenceScriptsSize",
        "stakeCredentialDeposit",
        "stakePoolDeposit",
        "stakePoolRetirementEpochBound",
        "stakePoolPledgeInfluence",
        "minStakePoolCost",
        "desiredNumberOfStakePools",
        "monetaryExpansion",
        "treasuryExpansion",
        "collateralPercentage",
        "maxCollateralInputs",
        "plutusCostModels",
        "scriptExecutionPrices",
        "maxExecutionUnitsPerTransaction",
        "maxExecutionUnitsPerBlock",
        "stakePoolVotingThresholds",
        "constitutionalCommitteeMinSize",
        "constitutionalCommitteeMaxTermLength",
        "governanceActionLifetime",
        "governanceActionDeposit",
        "delegateRepresentativeVotingThresholds",
        "delegateRepresentativeDeposit",
        "delegateRepresentativeMaxIdleTime",
        "version"
      ],
      "properties": {
        "minFeeCoefficient": { "type": "integer", "minimum": 0 },
        "minFeeConstant": {
          "type": "integer",
          "minimum": 0,
          "description": "Lovelace."
        },
        "minFeeReferenceScripts": { "$ref": "#/$defs/MinFeeReferenceScripts" },
        "minUtxoDepositCoefficient": { "type": "integer", "minimum": 0 },
        "maxBlockBodySize": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes."
        },
        "maxBlockHeaderSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Bytes."
        },
        "maxTransactionSize": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes."
        },
        "maxValueSize": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes."
        },
        "maxReferenceScriptsSize": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes."
        },
        "stakeCredentialDeposit": {
          "type": "integer",
          "minimum": 0,
          "description": "Lovelace."
        },
        "stakePoolDeposit": {
          "type": "integer",
          "minimum": 0,
          "description": "Lovelace."
        },
        "stakePoolRetirementEpochBound": { "type": "integer", "minimum": 0 },
        "stakePoolPledgeInfluence": { "$ref": "#/$defs/Ratio" },
        "minStakePoolCost": {
          "type": "integer",
          "minimum": 0,
          "description": "Lovelace."
        },
        "desiredNumberOfStakePools": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "monetaryExpansion": { "$ref": "#/$defs/Ratio" },
        "treasuryExpansion": { "$ref": "#/$defs/Ratio" },
        "collateralPercentage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "maxCollateralInputs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "plutusCostModels": { "$ref": "#/$defs/PlutusCostModels" },
        "scriptExecutionPrices": { "$ref": "#/$defs/ScriptExecutionPrices" },
        "maxExecutionUnitsPerTransaction": { "$ref": "#/$defs/ExecutionUnits" },
        "maxExecutionUnitsPerBlock": { "$ref": "#/$defs/ExecutionUnits" },
        "stakePoolVotingThresholds": {
          "$ref": "#/$defs/StakePoolVotingThresholds"
        },
        "constitutionalCommitteeMinSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "constitutionalCommitteeMaxTermLength": {
          "type": "integer",
          "minimum": 0
        },
        "governanceActionLifetime": { "type": "integer", "minimum": 0 },
        "governanceActionDeposit": {
          "type": "integer",
          "minimum": 0,
          "description": "Lovelace."
        },
        "delegateRepresentativeVotingThresholds": {
          "$ref": "#/$defs/DelegateRepresentativeVotingThresholds"
        },
        "delegateRepresentativeDeposit": {
          "type": "integer",
          "minimum": 0,
          "description": "Lovelace."
        },
        "delegateRepresentativeMaxIdleTime": {
          "type": "integer",
          "minimum": 0
        },
        "version": { "$ref": "#/$defs/ProtocolVersion" }
      }
    },
    "Expected": {
      "oneOf": [
        { "const": "Pass" },
        {
          "type": "object",
          "required": ["predicate"],
          "description": "The predicate the transaction must fail. Some predicates carry additional fields that narrow which of their cases is expected.",
          "properties": {
            "predicate": { "type": "string" },
            "description": {
              "enum": ["PassedUnexpectedly", "FailedUnexpectedly"],
              "description": "Required for ValidationTagMismatch: which way round the transaction's is_valid flag disagrees with script evaluation. PassedUnexpectedly covers a transaction with no Plutus script at all, since an empty script set trivially passes."
            }
          }
        },
        {
          "type": "object",
          "description": "The transaction must fail to decode; no validation is run.",
          "required": ["decodingFailure"],
          "properties": {
            "decodingFailure": { "const": true }
          }
        }
      ]
    }
  }
}
