cabal-version: 3.0

name:           haskell-node-extractor
version:        0
synopsis:       A tool for extracting test data from the Haskell's implementation.
description:    A tool for extracting test data from the Haskell's implementation, to be used for conformance.
category:       Web
stability:      experimental
homepage:       https://github.com/pragma-org/amaru
bug-reports:    https://github.com/pragma-org/amaru/issues
author:         KtorZ <matthias.benkort@gmail.com>
maintainer:     matthias.benkort@gmail.com
copyright:      2026 KtorZ
license:        Apache-2.0
license-file:   LICENSE
build-type:     Simple

source-repository head
  type: git
  location: https://github.com/pragma-org/amaru

library
  default-language: Haskell2010
  hs-source-dirs: src
  exposed-modules:
      Command
    , Command.ExtractSnapshot
    , Command.ExtractSnapshot.Error
    , Command.ExtractSnapshot.Parse
    , Command.ExtractSnapshot.Run
    , Command.StakeDistribution
    , Command.StakeDistribution.Error
    , Command.StakeDistribution.Parse
    , Command.StakeDistribution.Run
    , Command.ValidatePhaseOne
    , Command.ValidatePhaseOne.Error
    , Command.ValidatePhaseOne.Parse
    , Command.ValidatePhaseOne.Run
    , Data.Coin
    , Data.Credential
    , Data.DelegateRepresentative
    , Data.Genesis
    , Data.KeyHash
    , Data.Mandate
    , Data.Metadata
    , Data.NetworkName
    , Data.Nonce
    , Data.HexString
    , Data.PoolParameters
    , Data.PoolDelegator
    , Data.PoolId
    , Data.PoolRelay
    , Data.PoolRewardsInfo
    , Data.Rational
    , Data.RewardAddress
    , Data.RewardsProvenance
    , Data.Pools
    , Data.ScriptHash
    , Data.StakeDistribution.Account
    , Data.StakeDistribution.DRep
    , Data.StakeDistribution.Pool
    , Data.StakeDistribution
    , Data.VrfKeyHash
    , Error
    , Helpers.Json
    , Query.DelegateRepresentatives
    , Query.Nonces
    , Query.Pots
    , Query.Pools
    , Query.RewardsProvenance
    , Query.StakeDistribution
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints -Wunused-packages -threaded
  default-extensions:
      LambdaCase
      MultiWayIf
      NamedFieldPuns
      NoImplicitPrelude
      OverloadedStrings
      TypeApplications
  build-depends:
      aeson
    , aeson-pretty
    , base >=4.7 && <5
    , base16
    , bytestring
    , cardano-crypto-class
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-byron
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-shelley
    , cardano-slotting
    , cardano-strict-containers
    , containers
    , data-default-class
    , directory
    , filepath
    , fs-api
    , microlens
    , mtl
    , optparse-applicative
    , ouroboros-consensus:{ouroboros-consensus, cardano, protocol}
    , relude
    , serialise
    , sop-extras
    , time
    , vector-map

executable haskell-node-extractor
  main-is: Main.hs
  default-language: Haskell2010
  hs-source-dirs: app
  ghc-options: -rtsopts
  build-depends:
      base >=4.7 && <5
    , haskell-node-extractor
